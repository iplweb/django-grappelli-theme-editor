{
  "name": "Clean Slate",
  "description": "White top bar, Inter type, airy cards and lines instead of grids — a modern SaaS look.",
  "font_sans": "Inter, system-ui, sans-serif",
  "font_scale": "1.05",
  "spacing_scale": "1.15",
  "seeds": {
    "light": {
      "accent": "#2563eb",
      "background": "#f8fafc",
      "text": "#1e293b",
      "chrome": "#1e293b"
    },
    "dark": {
      "accent": "#60a5fa",
      "background": "#0f172a",
      "text": "#e2e8f0",
      "chrome": "#020617"
    }
  },
  "components": {
    "general": {
      "surfaces": "flat",
      "link_decoration": "hover"
    },
    "navbar": {
      "background": {
        "light": "#ffffff",
        "dark": "#0b1222"
      },
      "text": {
        "light": "#0f172a",
        "dark": "#f1f5f9"
      },
      "link": {
        "light": "#1d4ed8",
        "dark": "#93c5fd"
      },
      "link_hover": {
        "light": "#0f172a",
        "dark": "#ffffff"
      },
      "border": 1,
      "border_color": {
        "light": "#e2e8f0",
        "dark": "#1e293b"
      },
      "padding_y": 16,
      "title_size": 16,
      "shadow": "subtle"
    },
    "breadcrumbs": {
      "background": {
        "light": "#f8fafc",
        "dark": "#0f172a"
      },
      "text_shadow": "none",
      "padding_y": 10,
      "link": {
        "light": "#1d4ed8",
        "dark": "#93c5fd"
      },
      "border": {
        "light": "#e2e8f0",
        "dark": "#1e293b"
      }
    },
    "buttons": {
      "radius": 8,
      "height": 34,
      "padding_x": 16,
      "weight": "600",
      "shadow": "subtle",
      "dim_secondary": "full",
      "border": 0
    },
    "inputs": {
      "radius": 8,
      "height": 34,
      "inner_shadow": "none",
      "focus": "ring",
      "weight": "normal",
      "padding_x": 10
    },
    "modules": {
      "radius": 12,
      "group_radius": 12,
      "border": 1,
      "shadow": "subtle",
      "spacing": 16,
      "header_text_shadow": "none",
      "header_size": 13,
      "header_padding": 10
    },
    "filters": {
      "radius": 10,
      "open_shadow": "medium",
      "search_radius": 8
    },
    "tables": {
      "radius": 12,
      "grid": "rows",
      "stripes": "off",
      "header_transform": "uppercase",
      "header_surface": "flat",
      "row_hover": {
        "light": "#f1f5f9",
        "dark": "#1e293b"
      }
    },
    "messages": {
      "radius": 10,
      "style": "accent",
      "weight": "normal"
    },
    "object_tools": {
      "radius": 8,
      "opacity": "full",
      "shadow": "subtle"
    },
    "footer": {
      "surface": "flat",
      "shadow": "soft",
      "item_frame": "off"
    },
    "popups": {
      "radius": 10,
      "shadow": "medium"
    },
    "pagination": {
      "radius": 8,
      "gap": 4
    },
    "login": {
      "radius": 16,
      "shadow": "floating"
    },
    "icons": {
      "add_icon": "custom",
      "add_glyph": "＋",
      "filter_arrow": "chevron",
      "submit_style": "icon_text"
    }
  },
  "format": "grappelli-theme-editor/1",
  "light_tokens": {
    "--grp-dark-border-shade-color": "#e2e8f0",
    "--grp-dark-border-highlight-color": "#ffffff"
  }
}
